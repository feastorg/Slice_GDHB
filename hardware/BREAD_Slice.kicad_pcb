			)
			(justify left bottom mirror)
		)
	)
	(gr_text "Stackup: 4 layers, 1 oz (0.035 mm) copper on every layer, 1.6 mm.\nRated 10 A continuous, VBB 24 V max.\n\nL1 F.Cu: FETs, one pour per node (VBB, SA, SB, PGND), gate drive, logic.\nL2 In1.Cu: PGND plane under the power stage; +5V under the Nano.\nL3 In2.Cu: VBB plane under the power stage; GND (logic) elsewhere.\nL4 B.Cu: copies of SA, SB and VBB under the power stage; 5 V buck.\n\nPGND joins GND only through NT2, beside U2."
		(at 197.47 94.65 0)
		(layer "Cmts.User")
		(uuid "0ef20153-c8b8-45c3-a37b-6675ea57c34a")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "L1 (Top):\n    - Routing\n\nL2 (Inner 1):\n    - 5V\n\nL3 (Inner 2):\n    - GND\n\nL4 (Bottom):\n    - 12-->5V regulator"
		(at 202.71 138.51 0)
		(layer "Cmts.User")
		(uuid "60209480-17ab-408b-b4f3-47461165ae52")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
