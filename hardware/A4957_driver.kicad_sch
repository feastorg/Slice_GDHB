	(text "Let Cboot = Qgate / Vboot\n\nVboot = appx 16V\nQgate for these \nfets is 15nC\n\nCboot = 15nC / 16V \n=~ 1nF\n\nCould go to 10nF if not \ndriving quick enough"
		(exclude_from_sim no)
		(at 114.3 114.554 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left bottom)
		)
		(uuid "66ca01b3-51ff-4294-9b77-4492e98f6aec")
	)
