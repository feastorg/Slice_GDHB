	)
	(text "RDEAD -> Rdead -> GND:\nt_DEAD ≈ 50 + 7200 / (1.2 + (200 / R_DEAD))\n		-> for R_DEAD > 3kOhms\n		-> see datasheet for curve\n\nRDEAD -> VDD: 6µs dead time\n\nRDEAD -> GND: no dead time, must be supplied by controller\n		-> i.e. logic control signals must incorporate dead time "
		(exclude_from_sim no)
		(at 199.644 148.336 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left bottom)
		)
		(uuid "c512fed3-9770-476b-b048-e781b4f3cd72")
	)
