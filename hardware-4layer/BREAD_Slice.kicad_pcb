	(gr_text "L1 (Top):\n    - All FETs and high-current copper pours (VBB, SA, SB)\n    - Primary routing for motor power and gate drive signals\n    - Thick copper (2-3 oz)\n    - Thermal via arrays under FETs and A4957 exposed pad\n    - Minimal digital traces; avoid signal routing near power zones\n\nL2 (Inner 1):\n    - Signal layer for logic routing\n\nL3 (Inner 2):\n    - Solid ground plane (1-2 oz)\n    - Connect all IC grounds, FET sources, and thermal vias\n    - Low-impedance return path for gate drivers and control logic\n    - Avoid cuts or splits; use stitching vias liberally\n\nL4 (Bottom):\n    - Dedicated VBB power plane (2 oz)\n    - Large continuous pour connected to top-side VBB with via stitching\n    - Add thermal spreading zones beneath FETs and A4957"
		(at 197.47 94.65 0)
		(layer "Cmts.User")
		(uuid "0ef20153-c8b8-45c3-a37b-6675ea57c34a")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "L1 (Top):\n    - Routing\n\nL2 (Inner 1):\n    - 5V\n\nL3 (Inner 2):\n    - GND\n\nL4 (Bottom):\n    - 12-->5V regulator"
		(at 202.71 138.51 0)
		(layer "Cmts.User")
		(uuid "60209480-17ab-408b-b4f3-47461165ae52")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
